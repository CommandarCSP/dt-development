{
  "description": "dt-development pipeline nudges — wrap routine on Stop, branch reminder on UserPromptSubmit (opt-in via .dt-pipeline.json)",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/start-detect.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/wrap-detect.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
